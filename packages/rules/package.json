{
  "name": "@hero-u/rules",
  "version": "1.3.0",
  "description": "Manage and sync AI tool instructions across tools and projects, and configure LLM model lists",
  "keywords": [
    "hero-u",
    "ai",
    "rules",
    "claude",
    "copilot",
    "cursor",
    "models",
    "llm"
  ],
  "repository": "github:dancerphil/hero-u",
  "author": "Cong Zhang <dancerphil1994@gmail.com>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rules": "es/cli.js"
  },
  "files": [
    "es"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf es/ && tsc && vite build",
    "dev": "concurrently \"tsx watch src/cli.ts -- --no-open\" \"vite --open\"",
    "lint-type": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@hero-u/model": "workspace:*",
    "@hono/node-server": "^2.0.11",
    "hono": "^4.12.31",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.4.2",
    "@mantine/hooks": "^9.4.2",
    "@tabler/icons-react": "^3.45.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "region-react": "^12.2.0",
    "tsx": "^4.23.1",
    "vite": "^8.1.5"
  }
}
